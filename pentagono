import matplotlib.pyplot as plt

A = (2, 1, 0)
B = (4, 1, 0)
C = (5, 3, 0)
D = (3, 5, 0)
E = (1, 3, 0)

vertices = [A, B, C, D, E]

fig = plt.figure()
ax = fig.add_subplot(111, projection='3d')

for nombre, v in zip(["A", "B", "C", "D", "E"], vertices):
    ax.scatter(*v)
    ax.text(*v, nombre)

aristas = [
    (A, B), (B, C), (C, D),
    (D, E), (E, A)
]

for p, q in aristas:
    ax.plot([p[0], q[0]], [p[1], q[1]],
            [p[2], q[2]])

ax.set_title("Pentágono 3D")
plt.show()